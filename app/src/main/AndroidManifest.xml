<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork/registerBestMatchingNetworkCallback 必需；
         少了它就只能用 registerDefaultNetworkCallback，而那个从 Android P 起
         会把 VPN 自己当成默认网络，导致引擎报 no available network interface -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- 前台服务：VPN 属于 systemExempted（照 sing-box 官方实现；用 specialUse 会在 Android 14 崩溃） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Android 13+ 前台服务通知必须显式授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机 / 应用更新后恢复连接 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 引导用户加入电池优化白名单，降低被国产 ROM 杀后台的概率 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      刻意不申请的权限（sing-box 官方客户端有，我们不需要）：
      ACCESS_FINE_LOCATION / ACCESS_BACKGROUND_LOCATION —— 官方用于按 WiFi 名切换规则
      CAMERA —— 官方用于扫二维码导入配置
      WRITE_EXTERNAL_STORAGE —— 官方用于导入导出配置文件
      本 app 只有「输邀请码 + 一个开关」，多要一个权限就多一分不信任。
    -->

    <application
        android:name=".RedFluentApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RedFluentVPN">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.RedFluentVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.RedFluentVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- 不支持系统的「始终开启的 VPN」：配置是连接时按所选区域现取的，
                 系统自己拉起服务时没有配置可用。声明出来，设置里就不会出现这个开关。 -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
        </service>

        <receiver
            android:name=".vpn.BootReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
